<?xml version="1.0" encoding="UTF-8"?>
<database>
    <global>
        <table name="areas">
            <field type="integer" autoincrement="true" primary="true">id</field>
            <field type="boolean" default="0">ocp</field>
        </table>

        <table name="requests">
            <field type="integer" autoincrement="true" primary="true">id</field>
            <field type="string" length="255" nullable="true" default="null">project</field>
            <field type="string" length="10" nullable="true" default="null">lang</field>
            <field type="integer" nullable="true" default="null">site_id</field>
            <field type="datetime">created_at</field>
            <field type="string" length="255">first_name</field>
            <field type="string" length="255">last_name</field>
            <field type="string" length="255">email</field>
            <field type="string" length="255" nullable="true" default="null">phone</field>
            <field type="string" length="255">order_no</field>
            <field type="date" nullable="true" default="null">order_date</field>
            <field type="text">message</field>
            <field type="boolean" default="0">privacy_policy_accepted</field>
            <field type="string" length="32" default="new">status</field>
        </table>
    </global>
</database>
